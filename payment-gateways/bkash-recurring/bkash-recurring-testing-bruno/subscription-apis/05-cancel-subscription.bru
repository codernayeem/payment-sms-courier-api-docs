meta {
  name: #7 Cancel Subscription
  type: http
  seq: 5
}

delete {
  url: {{bkashBaseUrl}}/api/subscriptions/{{bkashSubscriptionId}}
  body: none
  auth: none
}

params:query {
  reason: Cancelled by admin
}

vars:pre-request {
  bkashSubscriptionId: 88591
}

tests {
  const json = res.body;
  console.log("Cancel Subscription response:", JSON.stringify(json, null, 2));
  
  if (json && json.subscriptionStatus) {
    console.log("Subscription status after cancel:", json.subscriptionStatus);
  }
}

docs {
  Checklist #7.
  
  Cancels the active subscription using `bkashSubscriptionId`. bKash should later send the cancel webhook to your backend.
}
