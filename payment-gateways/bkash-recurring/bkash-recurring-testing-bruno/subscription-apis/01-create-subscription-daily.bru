meta {
  name: #1 Create Subscription - DAILY
  type: http
  seq: 1
}

post {
  url: {{bkashBaseUrl}}/api/subscription
  body: json
  auth: none
}

body:json {
  {
    "subscriptionRequestId": "{{subscriptionRequestId}}",
    "serviceId": {{bkashServiceId}},
    "paymentType": "FIXED",
    "subscriptionType": "BASIC",
    "amount": 25,
    "currency": "BDT",
    "frequency": "DAILY",
    "startDate": "{{_startDate}}",
    "expiryDate": "{{_expiryDate}}",
    "maxCapRequired": false,
    "payerType": "CUSTOMER",
    "payer": null,
    "firstPaymentIncludedInCycle": true,
    "merchantShortCode": "{{bkashMerchantShortCode}}",
    "redirectUrl": "{{callbackUrl}}",
    "subscriptionReference": "SUB-REF-01",
    "extraParams": null
  }
}

script:pre-request {
  const rid = "SUB-REQ-" + Date.now() + "-" + Math.random().toString(36).substring(2, 7).toUpperCase();
  bru.setVar("subscriptionRequestId", rid);
  bru.setVar("_generatedRid", rid);
  console.log("subscriptionRequestId set to:", rid);
  
  const bdtOffsetMs = 6 * 60 * 60 * 1000;
  const nowBdt = new Date(Date.now() + bdtOffsetMs);
  const startDate = nowBdt.toISOString().split("T")[0];
  const expiryDate = new Date(Date.now() + bdtOffsetMs + (2 * 365.25 * 24 * 60 * 60 * 1000)).toISOString().split("T")[0];
  
  bru.setVar("_startDate", startDate);
  bru.setVar("_expiryDate", expiryDate);
  console.log("startDate:", startDate, " expiryDate:", expiryDate);
}

tests {
  const json = res.body;
  console.log("Create Subscription (DAILY) response:", JSON.stringify(json, null, 2));
  
  if (json && json.redirectURL) {
    console.log("");
    console.log("=== OPEN THIS URL IN BROWSER TO COMPLETE CONSENT ===");
    console.log(json.redirectURL);
    console.log("===================================================");
    bru.setVar("_lastRedirectURL", json.redirectURL);
  }
  
  if (json && json.subscriptionRequestId) {
    bru.setVar("subscriptionRequestId", json.subscriptionRequestId);
    console.log("subscriptionRequestId updated from response:", json.subscriptionRequestId);
  }
}

docs {
  Checklist #1 for `DAILY`.
  
  This request generates a fresh `subscriptionRequestId`, computes the start and expiry dates in Bangladesh time, and stores both as runtime variables.
  
  For checklist #5, run this after 11:30 PM Bangladesh time and verify bKash rejects it.
}