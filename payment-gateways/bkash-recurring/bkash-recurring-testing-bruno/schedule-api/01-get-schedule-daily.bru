meta {
  name: #19 Get Schedule - DAILY
  type: http
  seq: 1
}

get {
  url: {{bkashBaseUrl}}/api/subscription/payment/schedule?frequency=DAILY&startDate=2026-09-23&expiryDate=2026-09-30
  body: none
  auth: none
}

params:query {
  frequency: DAILY
  startDate: 2026-09-23
  expiryDate: 2026-09-30
}

vars:pre-request {
  _schedStartDate: 16-05-2026
  _schedExpiryDate: 18-05-2026
}

script:pre-request {
  const bdtOffsetMs = 6 * 60 * 60 * 1000;
  const nowBdt = new Date(Date.now() + bdtOffsetMs);
  const tomorrowBdt = new Date(Date.now() + bdtOffsetMs + (24 * 60 * 60 * 1000));
  
  bru.setVar("_schedStartDate", nowBdt.toISOString().split("T")[0]);
  bru.setVar("_schedExpiryDate", tomorrowBdt.toISOString().split("T")[0]);
}

tests {
  const json = res.body;
  console.log("Schedule (DAILY) response:", JSON.stringify(json, null, 2));
}

docs {
  Checklist #19 for a daily schedule example.
}
